// pages/buyer/[orderid].tsx
import React, { useEffect, useState } from 'react';
import { useRouter } from 'next/router';
import { supabase } from '../../lib/supabaseClient';
import Link from 'next/link';

interface Order {
  id: number;
  total: number;
  status: string;
  created_at: string;
  // If you store items, you can add an array here and render them
  // items?: { id: string; name: string; quantity: number; price: number }[];
}

const BuyerOrderConfirmation: React.FC = () => {
  const router = useRouter();
  const { orderid } = router.query as { orderid?: string };
  const [order, setOrder] = useState<Order | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    if (!orderid) return;
    const fetchOrder = async () => {
      setLoading(true);
      const { data, error } = await supabase
        .from<Order>('orders')
        .select('*')
        .eq('id', orderid)
        .single();
      if (error) {
        console.error('Error fetching order:', error);
      } else {
        setOrder(data);
      }
      setLoading(false);
    };
    fetchOrder();
  }, [orderid]);

  if (loading) {
    return <p style={{ padding: '2rem', textAlign: 'center' }}>Loading your order...</p>;
  }

  if (!order) {
    return (
      <div style={{ padding: '2rem', textAlign: 'center' }}>
        <h1>Order Not Found</h1>
        <Link href="/buyer/orders" legacyBehavior>
          <a>← Back to Orders</a>
        </Link>
      </div>
    );
  }

  return (
    <div style={{ maxWidth: 600, margin: '2rem auto', padding: '2rem', backgroundColor: '#111', color: '#fff', borderRadius: '12px', border: '2px solid #FFD700' }}>
      <h1 style={{ fontSize: '2rem', marginBottom: '1rem', color: '#FFD700' }}>Thank You for Your Order!</h1>
      <p style={{ marginBottom: '0.5rem' }}>
        Your order <strong>#{order.id}</strong> has been placed successfully.
      </p>
      <p style={{ marginBottom: '1rem' }}>
        <strong>Total:</strong> ${order.total.toFixed(2)}
      </p>
      <p style={{ marginBottom: '1rem' }}>
        <strong>Status:</strong> {order.status || 'Pending'}
      </p>
      <p style={{ fontSize: '0.9rem', color: '#aaa', marginBottom: '2rem' }}>
        Placed on {new Date(order.created_at).toLocaleString()}
      </p>
      <div style={{ display: 'flex', justifyContent: 'center', gap: '1rem' }}>
        <Link href="/buyer/orders" legacyBehavior>
          <a>
            <button style={{
              padding: '0.75rem 1.5rem',
              backgroundColor: '#FFD700',
              color: '#000',
              fontWeight: 'bold',
              border: 'none',
              borderRadius: '4px',
              cursor: 'pointer'
            }}>
              View Orders
            </button>
          </a>
        </Link>
        <Link href="/stores" legacyBehavior>
          <a>
            <button style={{
              padding: '0.75rem 1.5rem',
              backgroundColor: 'transparent',
              color: '#FFD700',
              fontWeight: 'bold',
              border: '2px solid #FFD700',
              borderRadius: '4px',
              cursor: 'pointer'
            }}>
              Continue Shopping
            </button>
          </a>
        </Link>
      </div>
    </div>
  );
};

export default BuyerOrderConfirmation;