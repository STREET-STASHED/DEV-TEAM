// pages/stores/[storeid]/products/[product_id].tsx
import React from 'react'
import { useRouter } from 'next/router'
import Link from 'next/link'
import { stores, products, Product, Store } from '../../../lib/mockProducts'
import { useCart } from '../../../context/CartContext'

const ProductDetail: React.FC = () => {
  const { storeid, product_id } = useRouter().query as {
    storeid?: string
    product_id?: string
  }
  const store = stores.find((s: Store) => s.id === storeid)
  const product = storeid
    ? products[storeid]?.find((p: Product) => p.id === product_id)
    : undefined
  const { addItem } = useCart()

  if (!store || !product) {
    return (
      <div style={{ padding: 20 }}>
        <h1>Product Not Found</h1>
        <Link href="/stores">← Back to Stores</Link>
      </div>
    )
  }

  return (
    <div style={{ padding: 20, maxWidth: 600, margin: '0 auto' }}>
      <h1 style={{ fontSize: 30 }}>{product.name}</h1>
      <img
        src={product.image}
        alt={product.name}
        style={{ width: '100%', maxWidth: 400, borderRadius: 12, marginBottom: 16, border: '1px solid #eee' }}
      />
      <p style={{ fontSize: 18 }}><strong>Price:</strong> ${product.price.toFixed(2)}</p>
      <button
        onClick={() => addItem(product)}
        style={{
          padding: '10px 18px',
          marginTop: 18,
          backgroundColor: '#111',
          color: '#fff',
          border: 'none',
          borderRadius: 4,
          cursor: 'pointer',
          fontWeight: 600,
          fontSize: 16,
        }}
      >
        Add to Cart
      </button>
      <div style={{ marginTop: 28 }}>
        <Link href={`/stores/${storeid}`}>← Back to {store.name}</Link>
      </div>
    </div>
  )
}

export default ProductDetail