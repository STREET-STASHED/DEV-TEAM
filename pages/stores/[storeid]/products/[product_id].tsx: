// pages/stores/[storeid]/products/[product_id].tsx
import React from 'react'
import { useRouter } from 'next/router'
import Link from 'next/link'
import { useCart } from '../../../../context/CartContext'

const demoStores = [
  { slug: 'drip-district', name: 'Drip District' },
  { slug: 'flex-kicks', name: 'Flex Kicks' },
  { slug: 'iceworks', name: 'Iceworks' },
  { slug: 'styled-by-mya', name: 'Styled by Mya' },
]

const demoProducts = [
  // Drip District
  { id: 'classic-street-hoodie', store_slug: 'drip-district', name: 'Classic Street Hoodie', price: 68, image: 'https://images.unsplash.com/photo-1465101162946-4377e57745c3?auto=format&fit=facearea&w=400&h=400', type: 'Clothing' },
  { id: 'retro-logo-tee', store_slug: 'drip-district', name: 'Retro Logo Tee', price: 32, image: 'https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=facearea&w=400&h=400', type: 'Clothing' },
  // Flex Kicks
  { id: 'air-hustle-sneakers', store_slug: 'flex-kicks', name: 'Air Hustle Sneakers', price: 125, image: 'https://images.unsplash.com/photo-1519864600265-abb23847ef2c?auto=format&fit=facearea&w=400&h=400', type: 'Shoes' },
  { id: 'gold-runner-highs', store_slug: 'flex-kicks', name: 'Gold Runner Highs', price: 185, image: 'https://images.unsplash.com/photo-1465101178521-c1a9136a83b4?auto=format&fit=facearea&w=400&h=400', type: 'Shoes' },
  // Iceworks
  { id: 'diamond-cuban-chain', store_slug: 'iceworks', name: 'Diamond Cuban Chain', price: 2100, image: 'https://images.unsplash.com/photo-1511379938547-c1f69419868d?auto=format&fit=facearea&w=400&h=400', type: 'Jewelry' },
  { id: 'gold-micro-jesus-piece', store_slug: 'iceworks', name: 'Gold Micro Jesus Piece', price: 650, image: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?auto=format&fit=facearea&w=400&h=400', type: 'Jewelry' },
  // Styled by Mya
  { id: 'birthday-drip-bundle', store_slug: 'styled-by-mya', name: 'Birthday Drip Bundle', price: 300, image: 'https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=facearea&w=400&h=400', type: 'Bundle' },
  { id: 'prom-night-flex', store_slug: 'styled-by-mya', name: 'Prom Night Flex', price: 425, image: 'https://images.unsplash.com/photo-1465101046530-73398c7f28ca?auto=format&fit=facearea&w=400&h=400', type: 'Bundle' },
]

const ProductDetail: React.FC = () => {
  const { storeid, product_id } = useRouter().query as {
    storeid?: string
    product_id?: string
  }

  const { addItem, hasItem } = useCart()

  const store = demoStores.find((s) => s.slug === storeid)
  const product = demoProducts.find(
    (p) => p.store_slug === storeid && p.id === product_id
  )

  if (!store || !product) {
    return (
      <div style={{ padding: 20 }}>
        <h1>Product Not Found</h1>
        <Link href="/stores">← Back to Stores</Link>
      </div>
    )
  }

  return (
    <div style={{ padding: 20, maxWidth: 600, margin: '0 auto' }}>
      <h1 style={{ fontSize: 30 }}>{product.name}</h1>
      <img
        src={product.image}
        alt={product.name}
        style={{
          width: '100%',
          maxWidth: 400,
          borderRadius: 12,
          marginBottom: 16,
          border: '1px solid #eee',
        }}
      />
      <p style={{ fontSize: 18 }}>
        <strong>Price:</strong> ${product.price.toFixed(2)}
      </p>
      <div style={{ fontSize: 14, color: '#AAA', marginBottom: 8 }}>{product.type}</div>
      <button
        onClick={() =>
          addItem({
            id: product.id,
            name: product.name,
            price: product.price,
            image: product.image,
            store_id: product.store_slug,
            quantity: 1,
          })
        }
        disabled={hasItem(product.id)}
        style={{
          padding: '10px 18px',
          marginTop: 18,
          backgroundColor: hasItem(product.id) ? '#aaa' : '#111',
          color: '#fff',
          border: 'none',
          borderRadius: 4,
          cursor: hasItem(product.id) ? 'not-allowed' : 'pointer',
          fontWeight: 600,
          fontSize: 16,
        }}
      >
        {hasItem(product.id) ? 'Added!' : 'Add to Cart'}
      </button>
      <div style={{ marginTop: 28 }}>
        <Link href={`/stores/${storeid}`}>← Back to {store.name}</Link>
      </div>
    </div>
  )
}

export default ProductDetail