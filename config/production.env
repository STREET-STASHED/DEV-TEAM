# Production Environment Configuration
NODE_ENV=production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Database Configuration (if using local PostgreSQL)
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/streetstashed

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Configuration
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_TELEMETRY_DISABLED=1

# Security - Using your generated secure keys
JWT_SECRET=JqFKiU02qz/MKJszDuVYn3nHRYP3bysYqsWW5Oc5L7P0p8fnea7f13pps/4u6sv9
ENCRYPTION_KEY=k9JdLP2mOWeacW44NU7XovztIWpbLMHTKQvv1FO0UBc=

# Monitoring
GRAFANA_PASSWORD=admin
PROMETHEUS_RETENTION=200h

# Performance
CACHE_TTL_RECOMMENDATIONS=300
CACHE_TTL_USER_PROFILE=600
CACHE_TTL_INSIGHTS=1800
CACHE_TTL_TRENDING=900
CACHE_TTL_MOOD=300

# External Services (optional)
WEATHER_API_KEY=your_weather_api_key
GOOGLE_ANALYTICS_ID=your_ga_id
SENTRY_DSN=your_sentry_dsn

# Production Security Settings
NODE_TLS_REJECT_UNAUTHORIZED=1
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session Security
SESSION_SECRET=JqFKiU02qz/MKJszDuVYn3nHRYP3bysYqsWW5Oc5L7P0p8fnea7f13pps/4u6sv9
COOKIE_SECRET=k9JdLP2mOWeacW44NU7XovztIWpbLMHTKQvv1FO0UBc=

# Database Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
