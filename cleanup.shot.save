#!/bin/bash

echo "🧹 Starting cleanup..."

# Remove legacy auth pages
rm -f pages/auth/Auth.tsx
rm -f pages/auth/index.tsx
rm -f pages/auth/ResetPassword.tsx
rm -f pages/auth/UpdatePassword.tsx
rm -f pages/auth/VerifyEmail.tsx
rm -f pages/auth/ErrorPage.tsx
echo "✅ Removed legacy auth files."

# Remove old/unused API routes
rm -f pages/api/test-env.ts
rm -rf pages/api/edge
rm -f pages/api/paymentIntents.create.ts
rm -rf pages/api/orders
rm -rf pages/api/products
echo "✅ Removed unused API files."

# Remove generic dashboard if you're using role-based dashboards
rm -f pages/dashboard/index.tsx
echo "✅ Removed generic dashboard page."

# Remove unused public assets
rm -f public/output.css
rm -f public/sw.js
rm -f public/workbox-*.js
echo "✅ Removed old build/PWA artifacts."

# Remove unused scripts
rm -f scripts/setUserRole.ts
echo "✅ Removed old role script."

# Remove unused Supabase helpers if replaced
rm -f supabase/_shared/init.ts
rm -f supabase/_shared/cors.ts
echo "✅ Cleaned up old Supabase helpers."

echo "🎉 Cleanup complete."

