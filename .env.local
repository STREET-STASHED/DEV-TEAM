# PERFORMANCE & CACHING
# =============================================================================
# Redis Configuration (Optional - for advanced caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache TTL Settings
CACHE_TTL_RECOMMENDATIONS=300
CACHE_TTL_USER_PROFILE=600
CACHE_TTL_INSIGHTS=1800
CACHE_TTL_TRENDING=900
CACHE_TTL_MOOD=300

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
NODE_TLS_REJECT_UNAUTHORIZED=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
NEXT_PUBLIC_CORS_ORIGIN=https://streetstashed-5yz2nwfv5-street-stasheds-projects.vercel.app

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000

# =============================================================================
# LOGGING & DEBUGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
NEXT_PUBLIC_DEBUG_MODE=false

# =============================================================================
# FEATURE FLAGS (Optional)
# =============================================================================
NEXT_PUBLIC_ENABLE_AI_STYLIST=true
NEXT_PUBLIC_ENABLE_AR_TRYON=true
NEXT_PUBLIC_ENABLE_SOCIAL_FEATURES=true
NEXT_PUBLIC_ENABLE_REWARDS=true
NEXT_PUBLIC_ENABLE_BLOCKCHAIN_REWARDS=false

